<?xml version="1.0"?>
<psalm
    errorLevel="7"
    resolveFromConfigFile="true"
    findUnusedBaselineEntry="true"
    findUnusedCode="false"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <directory name="src"/>
        <directory name="src-compat"/>
        <directory name="handlers"/>
        <ignoreFiles>
            <directory name="vendor"/>
            <!-- defines the same class twice inside a runtime conditional
                 (APCUIterator vs APCIterator parent), which crashes Psalm's
                 classlike storage -->
            <file name="src-compat/CacheIterator.php"/>
        </ignoreFiles>
    </projectFiles>
</psalm>
