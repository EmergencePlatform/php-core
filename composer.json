{
    "name": "emergence/php-core",
    "description": "Core library for Emergence PHP applications",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Chris Alfano",
            "email": "chris@jarv.us"
        }
    ],
    "autoload": {
        "classmap": ["src-compat/"],
        "psr-4": {
            "Emergence\\": "src/"
        }
    },
    "require": {
        "php": "^8.1",
        "symfony/var-dumper": "^5.4",
        "filp/whoops": "^2.15",
        "larapack/dd": "^1.1",
        "league/flysystem": "^1.1",
        "psr/log": "^1.1",
        "superbalist/flysystem-google-storage": "^7.2"
    },
    "require-dev": {
        "rector/rector": "^2.5",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "vimeo/psalm": "^6.16",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpunit/phpunit": "^10.5"
    },
    "config": {
        "policy": {
            "advisories": {
                "ignore-id": ["PKSA-y2cr-5h3j-g3ys"]
            }
        }
    }
}
